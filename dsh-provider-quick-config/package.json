{
  "name": "dsh-provider-quick-config",
  "version": "0.5.6",
  "private": true,
  "description": "发送键旁 + 号快速配置模型 Provider（llm-pi-ai 路由/模型/密钥），本地模型 60s 自动同步。正式安装形态：dsh.bundle 挂 Host，dsh.client 挂 Web UI。",
  "keywords": [
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "cordis",
    "llm-provider",
    "model-switcher",
    "provider-switcher",
    "multimodal",
    "vision",
    "vision-language-model",
    "screenshot",
    "image-upload",
    "file-upload",
    "media-gallery",
    "media-showcase",
    "chat-history",
    "history-search",
    "openai",
    "openai-compatible",
    "claude",
    "anthropic",
    "glm",
    "zhipu",
    "minimax",
    "ollama",
    "local-llm",
    "llm-gateway",
    "ai-tools",
    "ai-assistant",
    "composer",
    "web-ui"
  ],
  "main": "src/host.js",
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
